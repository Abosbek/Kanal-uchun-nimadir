Enter# ==========================================
# TELEGRAM CHANNEL MANAGER BOT - ENV SOZLAMALARI
# ==========================================

# --- Telegram Bot ---
BOT_TOKEN=7830086441:AAFnhKAJbEJat_c9fD42RNwYra_qp9jdQ_Q
# Bot adminlari (vergul bilan ajratilgan Telegram user ID lar)
ADMIN_IDS=6199850209,5856802616

# --- Kanal sozlamalari ---
# Kanal ID raqami (odatda -100 bilan boshlanadi) yoki @username
CHANNEL_ID=-1001832962811
CHANNEL_USERNAME=@Maxfiy_internet

# Har bir postga avtomatik qo'shiladigan imzo (footer)
CHANNEL_FOOTER="✅ Admin tomondan ko'rib chiqildi va tasdiqlandi\n📢 Bosh sahifa: @your_channel_username"

# --- Google Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Ma'lumotlar bazasi ---
# Supabase PostgreSQL uchun (production):
# postgresql+asyncpg://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres
# Lokal test uchun SQLite:
# sqlite+aiosqlite:///./bot_local.db
DATABASE_URL=sqlite+aiosqlite:///./bot_local.db

# --- Rasm xizmatlari ---
# Pollinations.ai uchun API kaliti shart emas (public endpoint)
POLLINATIONS_MODEL=flux

# --- RSS manbalari ---
PRODUCTHUNT_RSS=https://www.producthunt.com/feed
REDDIT_RSS=https://www.reddit.com/r/technology/.rss

# --- Server / Deployment (Render.com) ---
# Polling rejimida ishlatish uchun bo'sh qoldiring.
# Webhook rejimi uchun Render bergan public URL manzilini yozing:
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
PORT=10000

# Bot ishga tushish rejimi: "polling" yoki "webhook"
RUN_MODE=polling
